{
  "name": "feedback-recorder",
  "productName": "FeedbackRecorder",
  "version": "0.2.0",
  "private": true,
  "description": "Record a spoken walkthrough of one screen and hand it to a coding agent.",
  "author": "FeedbackRecorder",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/fetch-vendor.js",
    "build-info": "node scripts/write-build-info.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "test": "node --test \"test/*.test.js\"",
    "test:pipeline": "electron test/electron/main.js",
    "test:ui": "electron test/electron/ui-smoke.js",
    "test:import": "electron test/electron/import-e2e.js",
    "test:record": "electron test/electron/record-e2e.js",
    "test:update": "electron test/electron/update-download.js",
    "shots": "electron test/electron/screenshots.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}
